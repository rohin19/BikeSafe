@baseUrl = http://localhost:3001
@routeId = 1

### Register a test user
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Test",
  "email": "test123@example.com",
  "password": "password123"
}

### Log in
### The remaining requests require the authentication cookie created here.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "test123@example.com",
  "password": "password123"
}

### Verify the current authenticated user
GET {{baseUrl}}/api/auth/me

### Create a review
### The route must already exist in the routes table.
# @name createReview
POST {{baseUrl}}/api/reviews
Content-Type: application/json

{
  "route_id": {{routeId}},
  "review_rating": 4.5,
  "comment": "Mostly protected bike lanes with one steep section."
}

### List all community reviews
GET {{baseUrl}}/api/reviews

### List only reviews created by the logged-in user
GET {{baseUrl}}/api/reviews?mine=true

### List reviews for one route
GET {{baseUrl}}/api/reviews?route_id={{routeId}}

### Search route names, reviewer names, and comments
GET {{baseUrl}}/api/reviews?search=protected

### Combine supported filters
GET {{baseUrl}}/api/reviews?mine=true&route_id={{routeId}}&search=protected

### Read the review created above
GET {{baseUrl}}/api/reviews/{{createReview.response.body.$.review_id}}

### Update both the rating and comment
PATCH {{baseUrl}}/api/reviews/{{createReview.response.body.$.review_id}}
Content-Type: application/json

{
  "review_rating": 4.0,
  "comment": "Comfortable during off-peak hours."
}

### Read the review again to verify the update
GET {{baseUrl}}/api/reviews/{{createReview.response.body.$.review_id}}

### Update only the rating
PATCH {{baseUrl}}/api/reviews/{{createReview.response.body.$.review_id}}
Content-Type: application/json

{
  "review_rating": 3.5
}

### Update only the comment
PATCH {{baseUrl}}/api/reviews/{{createReview.response.body.$.review_id}}
Content-Type: application/json

{
  "comment": "Updated comment only."
}

### Clear the optional comment
PATCH {{baseUrl}}/api/reviews/{{createReview.response.body.$.review_id}}
Content-Type: application/json

{
  "comment": null
}

### Delete the review
DELETE {{baseUrl}}/api/reviews/{{createReview.response.body.$.review_id}}

### Confirm that the deleted review returns 404
GET {{baseUrl}}/api/reviews/{{createReview.response.body.$.review_id}}