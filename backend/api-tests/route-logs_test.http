POST http://localhost:3001/api/auth/register
Content-Type: application/json

{
  "name": "Alice",
  "email": "alice@example.com",
  "password": "demo_pass_1"
}

### Log in
POST http://localhost:3001/api/auth/login
Content-Type: application/json

{
  "email": "test123@example.com",
  "password": "password123"
}

### Authenticate
GET http://localhost:3001/api/auth/me

### Create a completed route log and its initial review.
### The route must already exist in routes table
# @name createRouteLog
POST http://localhost:3001/api/route-logs
Content-Type: application/json

{
  "route_id": 5,
  "street_names": [
    "Ontario St",
    "E 10th Ave",
    "Quebec St"
  ],
  "hazard_ids": [1],
  "initial_review": {
    "review_rating": 4,
    "safety_rating": 5,
    "difficulty_rating": 3,
    "comment": "Mostly protected bike lanes with one steep section."
  }
}

### List all route logs.
GET http://localhost:3001/api/route-logs

### List only route logs created by the currently logged-in user.
GET http://localhost:3001/api/route-logs?mine=true

### Find route logs that share at least one specified street.
### The comma and spaces are URL encoded.
GET http://localhost:3001/api/route-logs?streets=Ontario%20St%2CE%2010th%20Ave

### Read the route log created by the request above.
### Includes its reviews, linked hazards, and related route logs.
GET http://localhost:3001/api/route-logs/{{createRouteLog.response.body.$.route_log.route_log_id}}

### Add or update the current user's review for the created route log.
POST http://localhost:3001/api/route-logs/{{createRouteLog.response.body.$.route_log.route_log_id}}/reviews
Content-Type: application/json

{
  "review_rating": 4,
  "safety_rating": 4,
  "difficulty_rating": 2,
  "comment": "Comfortable during off-peak hours."
}

### Read the route log again to verify that the review was updated.
GET http://localhost:3001/api/route-logs/{{createRouteLog.response.body.$.route_log.route_log_id}}


### Update a route log
PATCH http://localhost:3001/api/route-logs/{{createRouteLog.response.body.$.route_log.route_log_id}}
Content-Type: application/json

{
  "street_names": [
    "Ontario St",
    "E 12th Ave",
    "Quebec St"
  ]
}

### Delete the route log
DELETE http://localhost:3001/api/route-logs/{{createRouteLog.response.body.$.route_log.route_log_id}}