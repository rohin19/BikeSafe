DELETE http://localhost:3001/api/hazards/9



### Validation tests --> ensure logged in as admin



### Create a valid hazard
### Expected: 200 OK
# @name createHazard
POST http://localhost:3001/api/hazards
Content-Type: application/json

{
  "title": "Validation test hazard",
  "description": "Temporary hazard used for route validation tests.",
  "category": "Construction",
  "severity": 3,
  "latitude": 49.2827,
  "longitude": -123.1207
}

### Reject a non-numeric hazard ID
### Expected: 400 Bad Request
GET http://localhost:3001/api/hazards/not-a-number

### Reject a negative hazard ID
### Expected: 400 Bad Request
GET http://localhost:3001/api/hazards/-1

### Reject zero as a hazard ID
### Expected: 400 Bad Request
GET http://localhost:3001/api/hazards/0

### Reject a decimal hazard ID
### Expected: 400 Bad Request
GET http://localhost:3001/api/hazards/1.5

### Return 404 for a valid ID that does not exist
### Expected: 404 Not Found
GET http://localhost:3001/api/hazards/999999999

### Reject a missing title
### Expected: 400 Bad Request
POST http://localhost:3001/api/hazards
Content-Type: application/json

{
  "description": "The title is missing.",
  "category": "Construction",
  "severity": 3,
  "latitude": 49.2827,
  "longitude": -123.1207
}

### Reject a whitespace-only title
### Expected: 400 Bad Request
POST http://localhost:3001/api/hazards
Content-Type: application/json

{
  "title": "   ",
  "description": "The title only contains spaces.",
  "category": "Construction",
  "severity": 3,
  "latitude": 49.2827,
  "longitude": -123.1207
}

### Reject a missing description
### Expected: 400 Bad Request
POST http://localhost:3001/api/hazards
Content-Type: application/json

{
  "title": "Missing description",
  "category": "Construction",
  "severity": 3,
  "latitude": 49.2827,
  "longitude": -123.1207
}

### Reject an unsupported category
### Expected: 400 Bad Request
POST http://localhost:3001/api/hazards
Content-Type: application/json

{
  "title": "Invalid category",
  "description": "This category is not part of the allowed list.",
  "category": "flood",
  "severity": 3,
  "latitude": 49.2827,
  "longitude": -123.1207
}

### Reject severity below 1
### Expected: 400 Bad Request
POST http://localhost:3001/api/hazards
Content-Type: application/json

{
  "title": "Severity too low",
  "description": "Severity zero should be rejected.",
  "category": "Other",
  "severity": 0,
  "latitude": 49.2827,
  "longitude": -123.1207
}

### Reject severity above 5
### Expected: 400 Bad Request
POST http://localhost:3001/api/hazards
Content-Type: application/json

{
  "title": "Severity too high",
  "description": "Severity six should be rejected.",
  "category": "Other",
  "severity": 6,
  "latitude": 49.2827,
  "longitude": -123.1207
}

